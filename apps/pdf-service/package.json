{
  "name": "@resumerx/pdf-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean --external @resumerx/shared --external pdfkit --external pdf-parse --external pdfjs-dist --external fastify --external @fastify/multipart --external docx --external @aws-sdk/client-s3 --external pino --external pino-pretty --external puppeteer-core",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@fastify/multipart": "^8.3.0",
    "@resumerx/shared": "workspace:*",
    "docx": "^8.5.0",
    "fastify": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "4.0.379",
    "pdfkit": "^0.15.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0",
    "puppeteer-core": "^22.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.13.4",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^8.57.0",
    "tsup": "^8.0.2",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
